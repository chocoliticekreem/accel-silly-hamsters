# Unset = built-in mock data. Set to the backend origin to use the real API, e.g.:
# VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Google Maps Platform key with the Map Tiles API enabled: turns on the "Photoreal" graphics mode
# (Google Photorealistic 3D Tiles). Put it in .env.local (git-ignored), never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
