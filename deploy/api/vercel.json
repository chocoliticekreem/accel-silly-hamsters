{
  "installCommand": "echo skip-node-install",
  "buildCommand": "echo no-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,data/processed/**,runs/**}",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/runs/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/runs/(.*)",
      "destination": "/runs/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
